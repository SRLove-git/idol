# ===== 拼豆预约 Docker Compose 环境变量 =====
# 用法：cp .env.example .env 后按需修改；不创建 .env 时会使用下方默认值

# 前端对外端口（默认 14173，避开宿主机正在跑的 4173 / DIY 后端 3000）
WEB_PORT=14173

# MySQL 映射到宿主机端口（默认 23306，避开本机 3306 / 13306）
MYSQL_PORT=23306

# Redis 映射到宿主机端口（默认 26379，避开本机 6379 / 16379）
REDIS_PORT=26379

# MySQL root 密码与库名（首次启动会初始化数据卷，之后不要随意改密码）
DB_PASSWORD=root
DB_NAME=diy

# JWT 密钥（生产务必换成随机值：openssl rand -hex 32）
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# 审核演示种子：true 时启动自动创建 reviewdemo 账号 + IDOL BEADS 门店（幂等）
REVIEW_DEMO_ENABLED=true

# 前端渲染的门店 ID
STORE_ID=1

# Caddy 域名与证书邮箱（自动 HTTPS / Let's Encrypt）
# 部署到服务器时填写你的真实域名，并把该域名的 A 记录解析到服务器 IP
DOMAIN=idol-sg.com
ACME_EMAIL=admin@idol-sg.com
