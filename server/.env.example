# ===== 服务端环境变量（开发默认值，生产以环境注入覆盖） =====
NODE_ENV=development

# 初始管理员（bootstrap 自动创建；生产必须配置 ADMIN_INITIAL_PASSWORD，
# 未配置时生产环境跳过创建，避免默认弱口令。开发默认 admin / admin123456）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
# App Store 审核演示种子：置 true 时启动自动创建 reviewdemo 账号与 IDOL BEADS 门店
# （桌位/时段/6 小时套餐），并预置演示短视频/配乐/通知；幂等，提审前开启、审完关闭
REVIEW_DEMO_ENABLED=false
REVIEW_DEMO_USERNAME=reviewdemo
REVIEW_DEMO_PASSWORD=ThinkOrigin#2026
REVIEW_DEMO_EMAIL=reviewdemo@thinkorigin.example

# 服务
PORT=3000

# CORS 白名单（逗号分隔的完整来源，如 https://admin.example.com）：
# 生产未配置时默认禁止跨域；开发未配置时放行所有来源
CORS_ORIGINS=

# 内容机审关键词（逗号分隔，管理端 /api/admin/moderation/keywords 可运行时增删；
# Redis 有配置时优先于此处）
CONTENT_KEYWORDS=

# MySQL（对齐 docker/compose.dev.yml）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=diy

# Redis（对齐 docker/compose.dev.yml）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 会话与鉴权（生产务必更换）
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# JWT 无缝轮换：历史密钥（逗号分隔，仅验签）。
# 轮换时先把旧密钥填到这里，再更新 JWT_SECRET / JWT_REFRESH_SECRET 并重启
JWT_LEGACY_SECRETS=
# access token 有效期（默认 2h；移动端/后台自动刷新，时长影响刷新频率）
JWT_ACCESS_TTL=2h

# 聊天图片上传目录（相对进程工作目录，生产挂载持久卷）
UPLOAD_DIR=uploads

# 对象存储：UPLOAD_PROVIDER=local（默认）或 s3（AWS S3 / MinIO / OSS / COS 等）
UPLOAD_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL_BASE=
S3_FORCE_PATH_STYLE=false

# 数据库迁移：生产置 true 时应用启动自动执行 migrations/（推荐），
# 开发环境默认 synchronize 建表，不需要开启
DB_MIGRATIONS_RUN=false

# MySQL 连接池大小（mysql2 默认 10；按服务器内存与并发调大，需 ≤ MySQL max_connections）
DB_POOL_SIZE=20

# 是否信任反向代理（nginx 后必须为 true，否则 req.ip 全部是代理地址，
# 验证码/登录等按 IP 限流会变成全站共享配额）
TRUST_PROXY=false

# ===== 安全模块 =====

# API 全局限流：每 IP 每分钟请求数（默认 300），窗口 60s，超限封锁 5 分钟；
# 认证接口单独配额（AUTH_THROTTLE_LIMIT，默认 10 次/分钟，注册/登录路由收紧到 5 次/分钟）。
# 测试（NODE_ENV=test）与 THROTTLE_DISABLED=true 时自动跳过，便于联调。
THROTTLE_DISABLED=false
THROTTLE_LIMIT=300
THROTTLE_TTL_MS=60000
THROTTLE_BLOCK_MS=300000
AUTH_THROTTLE_LIMIT=10

# 爬虫 UA 拦截：置 true 后注册/登录/上传接口拒绝已知脚本 UA（python-requests、curl、Scrapy 等）。
# 开发保持 false，便于 curl 联调；生产建议 true。
BLOCK_BOT_UA=false

# 人机验证：留空关闭；image（自托管 SVG 图形验证码，无需第三方密钥）或
# turnstile（Cloudflare）/ hcaptcha。
# 开启后注册/登录必须携带有效验证结果：image 需要 captchaId + captchaText，
# turnstile/hcaptcha 需要 captchaToken（客户端需先集成对应前端组件）。
CAPTCHA_PROVIDER=
# 图形验证码有效期（秒，默认 300）与单次验证码最大尝试次数（默认 3，超限需刷新）
CAPTCHA_TTL=300
CAPTCHA_MAX_ATTEMPTS=3
TURNSTILE_SECRET=
HCAPTCHA_SECRET=

# IP 维度注册限制：同一 IP 在 REGISTER_IP_WINDOW_H（小时）内最多注册 REGISTER_IP_MAX 个账号
REGISTER_IP_MAX=5
REGISTER_IP_WINDOW_H=24

# 邮箱验证码（开发环境验证码打印在服务端日志；生产接入 SMTP 后由邮件服务发送）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DIY手作工坊 <no-reply@example.com>
